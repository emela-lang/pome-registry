// sumdb: 読むのは R2 から、追記は Durable Object の Log だけが行う。
// 追記の口は HTTP に出さない。proxy の Worker が DO の binding（script_name: pome-sumdb）で呼ぶ。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pome-sumdb",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // ab2m.link は v0.22〜v0.23 のコンパイラの既定。切り捨てるまで残す。
  // 鍵の名前（origin）は sum.emela.ab2m.link のまま。替えると古いコンパイラが検証に落ちる。
  "routes": [
    { "pattern": "sum.emela.dev", "custom_domain": true },
    { "pattern": "sum.emela.ab2m.link", "custom_domain": true }
  ],
  // lookup にない版を取り込ませる先。
  "vars": { "PROXY_URL": "https://pomes.emela.dev" },
  "r2_buckets": [{ "binding": "SUMDB", "bucket_name": "pome-sumdb" }],
  "durable_objects": {
    "bindings": [{ "name": "LOG", "class_name": "Log" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Log"] }],
  // 秘密: SUMDB_SIGNER_KEY（signed-note の秘密鍵の形。名前が origin になる）
  "observability": { "enabled": true }
}
